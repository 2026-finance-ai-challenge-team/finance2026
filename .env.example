# 이 파일을 .env로 복사한 뒤 값을 채운다.
#   Windows PowerShell:  copy .env.example .env
#   bash:                cp .env.example .env
#
# .env는 .gitignore 대상이다. Secret Key를 코드·README·커밋에 절대 넣지 않는다.
# 발급 절차는 README.md의 "API 키 발급 방법" 토글에 있다.

# --- 네이버 클라우드 CLOVA OCR (필수) --------------------------------------
# 두 값은 반드시 같은 OCR 도메인의 것이어야 한다. 섞이면 401/403이 난다.

# 도메인 생성 시 발급되는 APIGW Invoke URL. General 템플릿은 .../general 로 끝난다.
NCP_OCR_INVOKE_URL=https://xxxxxxxxxx.apigw.ntruss.com/custom/v1/00000/xxxxxxxx/general

# 같은 도메인의 Secret Key. 요청 헤더 X-OCR-SECRET 값으로 그대로 들어간다.
NCP_OCR_SECRET_KEY=여기에_발급받은_Secret_Key
