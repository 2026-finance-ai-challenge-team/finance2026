# 이 파일을 .env로 복사한 뒤 값을 채운다.  cp .env.example .env
#
# .env는 .gitignore 대상이다. Secret Key를 코드·README·커밋에 절대 넣지 않는다.
# 두 값은 NCP 콘솔 > Services > AI Services > CLOVA OCR > 도메인 목록에서
# 같은 도메인의 것을 가져와야 한다. (섞이면 401/403)

# APIGW Invoke URL — 도메인 생성 시 발급. General 템플릿은 .../general 로 끝난다.
NCP_OCR_INVOKE_URL=https://xxxxxxxxxx.apigw.ntruss.com/custom/v1/00000/xxxxxxxx/general

# 도메인의 Secret Key — 요청 헤더 X-OCR-SECRET 값으로 그대로 들어간다.
NCP_OCR_SECRET_KEY=여기에_발급받은_Secret_Key
